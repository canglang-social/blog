---
import { render } from 'astro:content';
import { galleryWorks } from '../../lib/gallery';
import Detail from '../../components/gallery/Detail.astro';
export async function getStaticPaths() {return (await galleryWorks()).map(project=>({params:{slug:project.id},props:{project}}));}
const {project}=Astro.props;
const {Content}=await render(project);
---
<Detail project={project} lang="en" hasCaseStudy={['ragx','learn-to-ship'].includes(project.id)}>
  <Content />
</Detail>
