---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { localeFromId, slugFromId } from '../i18n/ui';

// The project-led landing (portfolio step 2): who Felix is in 30 seconds,
// then shipped projects with live proof. English-only by decision.
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const featured = (await getCollection('blog'))
  .filter((post) => localeFromId(post.id) === 'en' && post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Felix Han — AI Application Engineer"
      description="Shipped AI projects with live demos and measured quality: eval-driven RAG over financial filings, a deterministic study-ranking agent, and writing on working with AI."
      lang="en"
    />
  </head>
  <body>
    <Header lang="en" />
    <main>
      <section class="hero">
        <h1>Felix Han</h1>
        <p class="positioning">
          AI Application Engineer — TypeScript/React → AI systems, shipped and
          measured.
        </p>
        <div class="contact">
          <a href="mailto:canglangzhuoxi@gmail.com">Email</a>
          <a href="https://github.com/canglang-social" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/felix-han-854726413" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </section>

      <section class="projects" aria-label="Projects">
        <h2>Projects</h2>
        <ul class="project-list">
          {
            projects.map((project) => (
              <li class="project-card">
                <a class="project-main" href={`/projects/${project.id}/`}>
                  <span class="project-name">{project.data.name}</span>
                  <span class="project-metric">{project.data.metric}</span>
                  <p class="project-tagline">{project.data.tagline}</p>
                </a>
                <div class="project-links">
                  {project.data.demoUrl && (
                    <a href={project.data.demoUrl} target="_blank" rel="noopener">
                      Live demo ↗
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a href={project.data.repoUrl} target="_blank" rel="noopener">
                      GitHub ↗
                    </a>
                  )}
                  <a href={`/projects/${project.id}/`}>Case study →</a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="writing" aria-label="Writing">
        <h2>Writing</h2>
        <ul class="writing-list">
          {
            featured.map((post) => (
              <li>
                <a href={`/blog/${slugFromId(post.id)}/`}>
                  <time class="date">
                    <FormattedDate date={post.data.pubDate} lang="en" />
                  </time>
                  <span class="title">{post.data.title}</span>
                  <p class="desc">{post.data.description}</p>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="all-writing" href="/blog/">All writing →</a>
      </section>
    </main>
    <Footer lang="en" />
  </body>
</html>

<style>
  .hero {
    padding: 1.5rem 0 2.5rem;
  }
  .hero h1 {
    margin: 0 0 0.6rem;
    font-size: 2.6rem;
  }
  .positioning {
    margin: 0 0 1.1rem;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--heading);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.95rem;
  }
  .projects,
  .writing {
    margin-bottom: 3rem;
  }
  .projects h2,
  .writing h2 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
  }
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .project-card {
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
  }
  .project-main {
    display: block;
    padding: 1.1rem 1.25rem 0.25rem;
    text-decoration: none;
  }
  .project-name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--heading);
    margin-right: 0.75rem;
    transition: color 0.15s ease;
  }
  .project-main:hover .project-name {
    color: var(--accent);
  }
  .project-metric {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  .project-tagline {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.6rem 1.25rem 1rem;
    font-size: 0.88rem;
  }
  .project-links a {
    text-decoration: none;
  }
  .project-links a:hover {
    text-decoration: underline;
  }
  .writing-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .writing-list li + li {
    border-top: 1px solid var(--border);
  }
  .writing-list a {
    display: block;
    padding: 1rem 1.25rem;
    margin-inline: -1.25rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .writing-list a:hover {
    background: var(--surface-hover);
  }
  .writing-list .date {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
  }
  .writing-list .title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--heading);
    transition: color 0.15s ease;
  }
  .writing-list a:hover .title {
    color: var(--accent);
  }
  .writing-list .desc {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .all-writing {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .all-writing:hover {
    text-decoration: underline;
  }
</style>
