---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { localeFromId, slugFromId } from '../../../i18n/ui';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const enSlugs = new Set(
		posts.filter((p) => localeFromId(p.id) === 'en').map((p) => slugFromId(p.id)),
	);
	return posts
		.filter((post) => localeFromId(post.id) === 'zh')
		.map((post) => {
			const slug = slugFromId(post.id);
			return {
				params: { slug },
				props: {
					post,
					translationUrl: enSlugs.has(slug) ? `/blog/${slug}/` : undefined,
				},
			};
		});
}
type Props = {
	post: CollectionEntry<'blog'>;
	translationUrl?: string;
};

const { post, translationUrl } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} lang="zh" translationUrl={translationUrl}>
	<Content />
</BlogPost>
