---
import Gallery from '../../layouts/Gallery.astro';
import WorkCard from './WorkCard.astro';
import { galleryWorks, labels, topics, prefix } from '../../lib/gallery';
import type { Lang } from '../../i18n/ui';
interface Props {lang:Lang;board?:boolean}
const {lang,board=false}=Astro.props, zh=lang==='zh', base=prefix(lang);
const projects=await galleryWorks();
const title=board?(zh?'工 · 项目作品':'Works'):(zh?'山水之间，事有回响。':'A work in progress.');
const description=zh?'我是沧浪。用 AI 构建作品，沿着问题探索，记录沿途的发现。':'I’m Felix. I build with AI, follow questions, and write along the way.';
---
<Gallery lang={lang} title={title} description={description} switchUrl={`${zh?'':'/zh'}${board?'/projects/':'/'}`}>
  <section class="gallery-intro shell"><div><h1>{title}</h1><p>{description}</p><a href={`${base}/about/`}>{zh?'知吾者':'About me'}</a></div><span class="gallery-inscription" aria-hidden="true">{zh?'所作 · 所思':'Work, unfolding'}</span></section>
  <section class="exhibition shell" aria-label={zh?'作品展':'Work exhibition'}>
    <div class="exhibition-heading"><h2>{zh?'工':'Works'}</h2>{!board&&<a href={`${base}/projects/`}>{zh?'按主题与状态浏览':'Browse by topic or status'}</a>}</div>
    {board&&<form class="gallery-filters" role="search"><label>{zh?'状态':'Status'}<select name="status"><option value="all">{zh?'全部':'All'}</option>{Object.entries(labels).map(([id,label])=><option value={id}>{label[lang]}</option>)}</select></label><label>{zh?'主题':'Topic'}<select name="topic"><option value="all">{zh?'全部':'All'}</option>{Object.entries(topics).map(([id,label])=><option value={id}>{label[lang]}</option>)}</select></label><button type="reset">{zh?'清除筛选':'Clear filters'}</button><output aria-live="polite"></output></form>}
    <div class="masonry">{projects.map((p,index)=><WorkCard project={p} lang={lang} index={index}/>)}</div>
    <p class="gallery-empty" hidden>{zh?'当前筛选下没有作品。试试其他主题或清除筛选。':'No works match. Try another topic or clear the filters.'}</p>
    <p class="gallery-footnote">{zh?'— 表示用量尚未记录，并非零。底板高度参考近 30 天已记录的 AI token，用量不代表作品价值。':'— means usage is not yet recorded, not zero. Mount height reflects recorded AI tokens over 30 days, not the value of a work.'}</p>
  </section>
</Gallery>
<script>
  const grid=document.querySelector<HTMLElement>('.masonry')!;
  const cards=[...grid.querySelectorAll<HTMLElement>('.exhibition-card')];
  const form=document.querySelector<HTMLFormElement>('.gallery-filters');
  function layout(){
    const gap=48, width=grid.clientWidth, cols=Math.max(1,Math.min(5,Math.floor((width+gap)/368))), cw=(width-gap*(cols-1))/cols;
    const heights=Array(cols).fill(0);grid.classList.add('laid-out');grid.dataset.columns=String(cols);
    for(const card of cards.filter(c=>!c.hidden)){card.style.width=`${cw}px`;const col=heights.indexOf(Math.min(...heights));card.style.left=`${col*(cw+gap)}px`;card.style.top=`${heights[col]}px`;heights[col]+=card.offsetHeight+gap}
    grid.style.height=`${Math.max(0,...heights.map(h=>h-gap))}px`;
  }
  function applyFilters(){
    if(!form){layout();return}
    const params=new URLSearchParams(location.search), status=form.elements.namedItem('status') as HTMLSelectElement, topic=form.elements.namedItem('topic') as HTMLSelectElement;
    status.value=[...status.options].some(o=>o.value===params.get('status'))?params.get('status')!:'all';
    topic.value=[...topic.options].some(o=>o.value===params.get('topic'))?params.get('topic')!:'all';
    for(const card of cards) card.hidden=!(status.value==='all'||card.dataset.status===status.value)||!(topic.value==='all'||card.dataset.topics!.split(' ').includes(topic.value));
    const count=cards.filter(c=>!c.hidden).length;form.querySelector('output')!.textContent=`${count} ${document.documentElement.lang==='zh'?'个作品':'works'}`;
    (document.querySelector('.gallery-empty') as HTMLElement).hidden=count>0;layout();
  }
  form?.addEventListener('change',()=>{const url=new URL(location.href);for(const key of ['status','topic']){const value=(form.elements.namedItem(key) as HTMLSelectElement).value;if(value==='all')url.searchParams.delete(key);else url.searchParams.set(key,value)}history.pushState(null,'',url);applyFilters()});
  form?.addEventListener('reset',()=>{const url=new URL(location.href);url.search='';history.pushState(null,'',url);applyFilters()});
  window.addEventListener('popstate',applyFilters);
  let width=0;new ResizeObserver(()=>{if(width!==grid.clientWidth){width=grid.clientWidth;layout()}}).observe(grid);
  document.fonts.ready.then(layout);window.addEventListener('pageshow',layout);
  for(const img of grid.querySelectorAll('img')){img.addEventListener('load',layout);img.addEventListener('error',()=>{img.closest('.exhibit-mount')?.classList.add('image-unavailable');layout()})}
  grid.addEventListener('click',e=>{const link=(e.target as Element).closest<HTMLAnchorElement>('.exhibit-link');if(link)try{sessionStorage.setItem('gallery-return',JSON.stringify({url:location.pathname+location.search,y:scrollY,work:link.closest<HTMLElement>('[data-work]')!.dataset.work}))}catch{}});
  applyFilters();
  try{const saved=JSON.parse(sessionStorage.getItem('gallery-return')||'null');if(saved?.url===location.pathname+location.search&&sessionStorage.getItem('gallery-restore')==='yes'){sessionStorage.removeItem('gallery-restore');requestAnimationFrame(()=>{layout();scrollTo(0,saved.y);cards.find(c=>c.dataset.work===saved.work)?.querySelector('a')?.focus({preventScroll:true})})}}catch{}
</script>
