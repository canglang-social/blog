---
import Artwork from './Artwork.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Gallery from '../../layouts/Gallery.astro';
import { art, nightArt, labels, topics, prefix, tokenLabel } from '../../lib/gallery';
import type { Lang } from '../../i18n/ui';
interface Props {project:CollectionEntry<'projects'>; lang:Lang; hasCaseStudy?:boolean}
const {project,lang,hasCaseStudy=false}=Astro.props, w=project.data.gallery!, zh=lang==='zh',base=prefix(lang);
const a=art[project.id as keyof typeof art];
const posts=(await getCollection('blog')).filter(p=>p.id.startsWith(`${lang}/`)&&w.relatedSlugs.includes(p.id.replace(/^(en|zh)\//,''))).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Gallery lang={lang} title={w.name[lang]} description={w.summary[lang]} image={a.image} switchUrl={`${zh?'':'/zh'}/projects/${project.id}/`}>
  <div class="detail-return shell"><a id="gallery-back" href={`${base}/`}>{zh?'← 返回作品展':'← Back to the exhibition'}</a><span>{zh?'作品档案':'Work archive'}</span></div>
  <section class="detail-exhibit shell"><figure><a data-art-original data-day-href={a.image.src} data-night-href={project.id in nightArt?nightArt[project.id as keyof typeof nightArt].image.src:a.image.src} href={a.image.src} target="_blank" rel="noopener" aria-label={zh?'查看完整原图':'Open full artwork'}><Artwork id={project.id as keyof typeof art} lang={lang} detail eager/></a><figcaption>{a.generated?(zh?'AI 生成插画 · 意象配图':'AI-generated illustration'):(zh?'既有项目截图':'Existing project screenshot')}</figcaption></figure><div class="detail-exhibit-label"><span class:list={['exhibit-status',w.status]}>{labels[w.status][lang]}</span><h1>{w.name[lang]}</h1><p>{w.summary[lang]}</p><div class="exhibit-topics">{w.topics.map(t=><span class="gallery-tag">{topics[t]?.[lang]??t}</span>)}</div>
  <div class="detail-current"><h2>{w.status==='paused'?(zh?'暂停缘由':'Why it is paused'):(zh?'近况':'Current chapter')}</h2><p>{(w.status==='paused'?w.pauseReason?.[lang]:undefined)??w.focus?.[lang]??(w.status==='archived'?(zh?'已归档，保留成果与沿途记录。':'Archived, with the work and its history preserved.'):(zh?'这里保留已公开的成果，当前进展尚待更新。':'Published work is preserved here; a current update is still to come.'))}</p>{w.statusCheckedAt&&<small>{zh?'状态记录于':'Status recorded'} {w.statusCheckedAt}</small>}{w.next&&<><h2>{zh?'问 · 下一步':'Next question'}</h2><p>{w.next[lang]}</p></>}</div>
  <div class="detail-links">{project.data.demoUrl&&<a href={project.data.demoUrl}>{zh?'项目演示':'Project demo'}</a>}{w.links.map(link=><a href={link.url}>{link.label[lang]}</a>)}{zh&&['ragx','learn-to-ship'].includes(project.id)&&<a href={`/projects/${project.id}/#case-study`} lang="en">完整案例（英文）</a>}</div></div></section>
  <nav class="detail-sections shell" aria-label={zh?'本页目录':'On this page'}><a href="#idea">{zh?'缘 · 项目初衷':'The idea'}</a><a href="#history">{zh?'迹 · 沿途节点':'Milestones'}</a><a href="#writing">{zh?'文 · 相关文章':'Related writing'}</a>{hasCaseStudy&&<a href="#case-study">{zh?'完整案例':'Full case study'}</a>}</nav>
  <div class="detail-body shell"><div class="detail-narrative"><section id="idea"><h2>{zh?'缘':'The idea'}</h2><p>{w.purpose[lang]}</p><h3>{zh?'我的贡献':'My contribution'}</h3><p>{w.contribution[lang]}</p></section><section id="history"><h2>{zh?'迹':'Along the way'}</h2>{w.milestones.length?<ol class="gallery-timeline">{w.milestones.map(m=><li>{m.date?<time datetime={m.date}>{m.date}</time>:<small>{zh?'未标日期的关键点':'Undated key point'}</small>}<h3>{m.title[lang]}</h3><p>{m.body[lang]}</p></li>)}</ol>:<p>{zh?'尚未记录历史节点。':'No milestones recorded yet.'}</p>}</section></div>
  <aside class="gallery-usage"><h2>{zh?'AI 用量':'AI usage'}</h2><dl><dt>{zh?'最近 30 天':'Last 30 days'}</dt><dd>{tokenLabel(w.usage.recent,lang)} {w.usage.recent!==null?'tokens':''}</dd><dt>{zh?'累计已记录':'Total recorded'}</dt><dd>{tokenLabel(w.usage.lifetime,lang)} {w.usage.lifetime!==null?'tokens':''}</dd></dl><p>{w.usage.coverage==='unknown'?(zh?'尚未接入可归属的用量。未知不等于零。':'Attributable usage is not connected yet. Unknown is not zero.'):(w.usage.coverage==='partial'?(zh?'部分记录：仅计主会话已观察到的增量，不含初始基线、子会话和图像生成。':'Partial record: observed parent-session deltas only; initial baseline, child sessions and image generation excluded.'):(zh?'已记录用量。':'Recorded usage.'))}</p>{w.usage.measuredAt&&<p><time datetime={w.usage.measuredAt}>{w.usage.measuredAt.slice(0,10)}</time> · {zh?'统计更新':'Measured'}</p>}{w.usage.start&&w.usage.end&&<p>{zh?'统计窗口（UTC）':'Window (UTC)'}<br/>{w.usage.start.slice(0,19).replace('T',' ')}<br/>{w.usage.end.slice(0,19).replace('T',' ')}</p>}{w.usage.measuredThrough&&<p>{zh?'记录截至（UTC）':'Recorded through (UTC)'}<br/>{w.usage.measuredThrough.slice(0,19).replace('T',' ')}</p>}{w.usage.recentCached!=null&&<p>{zh?'其中缓存输入':'Of which cached input'}：{tokenLabel(w.usage.recentCached,lang)} tokens</p>}<p>{zh?'Token 包含处理的上下文与输出，不代表作品价值或实际账单。':'Tokens include processed context and output. They do not measure value or actual spending.'}</p></aside>
  <section id="writing" class="detail-writing"><h2>{zh?'文':'Related writing'}</h2>{posts.length?posts.map(p=><a class="gallery-article" href={`${base}/blog/${p.id.replace(/^(en|zh)\//,'')}/`}><time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0,10)}</time><div><h3>{p.data.title}</h3><p>{p.data.description}</p></div></a>):<p>{zh?'相关文章将在这里继续积累。':'Related writing will collect here.'}</p>}</section>
  {hasCaseStudy&&<section class="gallery-case-study prose" id="case-study"><h2>Full case study</h2><slot/></section>}
  </div>
</Gallery>
<script>
  const back=document.querySelector<HTMLAnchorElement>('#gallery-back');
  try{const saved=JSON.parse(sessionStorage.getItem('gallery-return')||'null');if(back&&saved&&/^\/(zh\/)?(projects\/)?(\?.*)?$/.test(saved.url)&&saved.url.startsWith('/zh/')===(document.documentElement.lang==='zh')){back.href=saved.url;back.addEventListener('click',()=>{try{sessionStorage.setItem('gallery-restore','yes')}catch{}})}}catch{}
</script>
