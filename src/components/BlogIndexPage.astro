---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import Waves from './Waves.astro';
import { SITE_DESCRIPTION } from '../consts';
import {
  localeFromId,
  localeUrl,
  slugFromId,
  useTranslations,
  type Lang,
} from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog'))
  .filter((post) => localeFromId(post.id) === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Unique tags, ordered by frequency then alphabetically.
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={t('site.title')}
      description={SITE_DESCRIPTION}
      lang={lang}
    />
    <link rel="alternate" hreflang="en" href={new URL('/blog/', Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL('/zh/blog/', Astro.site)} />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <header class="page-head">
        <h1>{t('blog.heading')}</h1>
        <div class="poem-wrap">
          <Waves />
          <p class="poem">{SITE_DESCRIPTION}</p>
        </div>
      </header>

      {
        tags.length > 0 && (
          <div class="filters" role="group" aria-label={t('blog.filterLabel')}>
            <button class="chip is-active" data-filter="*" type="button">
              {t('blog.all')}
            </button>
            {tags.map((tag) => (
              <button class="chip" data-filter={tag} type="button">
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <ul class="post-list">
        {
          posts.map((post) => (
            <li data-tags={(post.data.tags ?? []).join(' ')}>
              <a href={localeUrl(lang, `/blog/${slugFromId(post.id)}/`)}>
                <time class="date">
                  <FormattedDate date={post.data.pubDate} lang={lang} />
                </time>
                <h2 class="title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="desc">{post.data.description}</p>
                )}
                {(post.data.tags ?? []).length > 0 && (
                  <div class="tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="empty" hidden>{t('blog.empty')}</p>
    </main>
    <Footer lang={lang} />

    <script is:inline>
      (() => {
        const chips = document.querySelectorAll('.chip');
        const items = document.querySelectorAll('.post-list li');
        const empty = document.querySelector('.empty');
        const apply = (filter) => {
          chips.forEach((c) =>
            c.classList.toggle('is-active', c.getAttribute('data-filter') === filter),
          );
          let visible = 0;
          items.forEach((li) => {
            const tags = (li.getAttribute('data-tags') || '').split(' ');
            const show = filter === '*' || tags.includes(filter);
            li.hidden = !show;
            if (show) visible++;
          });
          if (empty) empty.hidden = visible !== 0;
        };
        chips.forEach((chip) => {
          chip.addEventListener('click', () =>
            apply(chip.getAttribute('data-filter')),
          );
        });
        // Honor a ?tag= link coming from a post page.
        const wanted = new URLSearchParams(location.search).get('tag');
        if (wanted && [...chips].some((c) => c.getAttribute('data-filter') === wanted)) {
          apply(wanted);
        }
      })();
    </script>
  </body>
</html>

<style>
  .page-head {
    margin-bottom: 1.75rem;
  }
  .page-head h1 {
    margin-bottom: 0.5rem;
  }
  .poem-wrap {
    position: relative;
    overflow: hidden;
    padding: 1rem 1.1rem;
    margin-inline: -1.1rem;
    border-radius: 2px;
  }
  .poem {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-poem);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--heading);
    opacity: 0.92;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .chip {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .chip:hover {
    color: var(--heading);
    border-color: var(--muted);
  }
  .chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .post-list li[hidden] {
    display: none;
  }
  .post-list li + li {
    border-top: 1px solid var(--border);
  }
  .post-list a {
    display: block;
    padding: 1.5rem 1.25rem;
    margin-inline: -1.25rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .post-list a:hover {
    background: var(--surface-hover);
  }
  .post-list .date {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.35rem;
  }
  .post-list .title {
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
    color: var(--heading);
    transition: color 0.15s ease;
  }
  .post-list a:hover .title {
    color: var(--accent);
  }
  .post-list .desc {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--surface-hover);
    border-radius: 3px;
    padding: 0.15rem 0.55rem;
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0;
  }
</style>
