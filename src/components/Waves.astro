---
// Line-style flowing-water animation for the 沧浪之水 poem.
// Each wave is a stroked polyline that drifts left by exactly one
// wavelength, so the motion loops seamlessly.
const VW = 1440;
const VH = 200;

type Wave = {
  amp: number;
  wl: number; // wavelength
  y: number; // baseline
  dur: number; // seconds per loop
  op: number; // stroke opacity
};

const waves: Wave[] = [
  { amp: 12, wl: 480, y: 78, dur: 11, op: 0.4 },
  { amp: 20, wl: 600, y: 104, dur: 16, op: 0.28 },
  { amp: 9, wl: 360, y: 130, dur: 8, op: 0.55 },
];

function points({ amp, wl, y }: Wave): string {
  const width = VW + wl; // draw one extra wavelength for the drift
  const step = 6;
  const pts: string[] = [];
  for (let x = 0; x <= width; x += step) {
    const yy = y + amp * Math.sin((x / wl) * Math.PI * 2);
    pts.push(`${x},${yy.toFixed(1)}`);
  }
  return pts.join(' ');
}
---

<svg
  class="waves"
  viewBox={`0 0 ${VW} ${VH}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  {
    waves.map((w) => (
      <g style={`opacity:${w.op}`}>
        <polyline points={points(w)} />
        <animateTransform
          attributeName="transform"
          type="translate"
          from="0 0"
          to={`-${w.wl} 0`}
          dur={`${w.dur}s`}
          repeatCount="indefinite"
        />
      </g>
    ))
  }
</svg>

<style>
  .waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--accent);
  }
  .waves polyline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  @media (prefers-reduced-motion: reduce) {
    .waves :global(animateTransform) {
      display: none;
    }
  }
</style>
