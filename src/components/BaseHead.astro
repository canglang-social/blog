---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { defaultLang, type Lang } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** 'article' for blog posts, 'website' for index/landing pages. */
	type?: 'website' | 'article';
	lang?: Lang;
	publishedTime?: Date;
	updatedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	lang = defaultLang,
	publishedTime,
	updatedTime,
} = Astro.props;

// Share crawlers (WeChat, Facebook, Twitter) don't render SVG previews —
// rasterize SVG heroes to PNG at build time.
const ogImage =
	image.format === 'svg'
		? await getImage({ src: image, format: 'png', width: 1200 })
		: { src: image.src, attributes: { width: image.width, height: image.height } };
const imageURL = new URL(ogImage.src, Astro.site);
const imageWidth = Number(ogImage.attributes.width) || image.width;
const imageHeight = Number(ogImage.attributes.height) || image.height;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Theme: set before paint to avoid a flash -->
<script is:inline>
	(() => {
		const stored = localStorage.getItem('theme');
		const theme =
			stored ||
			(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		document.documentElement.dataset.theme = theme;
	})();
</script>
<meta name="theme-color" content="#f7f5ef" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Schema.org microdata (WeChat and some Chinese apps read these, not Open Graph) -->
<meta itemprop="name" content={title} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={imageURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
{publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{updatedTime && (
	<meta property="article:modified_time" content={updatedTime.toISOString()} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
