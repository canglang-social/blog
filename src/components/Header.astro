---
import type { Lang } from '../i18n/ui';
import { prefix } from '../lib/gallery';
import SiteBehavior from './SiteBehavior.astro';
import '../styles/gallery.css';
interface Props {lang?:Lang;switchUrl?:string}
const {lang='en',switchUrl:provided}=Astro.props;
const zh=lang==='zh',base=prefix(lang),switchUrl=provided??(zh?'/blog/':'/zh/blog/');
---
<a class="gallery-skip" href="#main">{zh?'跳到正文':'Skip to content'}</a>
  <header class="gallery-header shell">
    <a class="gallery-brand" href={`${base}/`}><img src="/cang-seal.svg" alt="" width="40" height="42"/><span>{zh?'沧浪':'Felix Han'}</span></a>
    <nav aria-label={zh?'主导航':'Main navigation'}>
      {[[zh?'知':'Writing',`${base}/blog/`,zh?'知 · 博客文章':'Writing'],[zh?'行':'Atlas',`${base}/atlas/`,zh?'行 · 实践地图':'Atlas'],[zh?'工':'Works',`${base}/projects/`,zh?'工 · 项目作品':'Works'],[zh?'吾':'About',`${base}/about/`,zh?'吾 · 关于我':'About']].map(([label,href,meaning])=><a href={href} title={meaning} aria-label={meaning} aria-current={Astro.url.pathname===href||Astro.url.pathname.startsWith(href)?'page':undefined}>{label}</a>)}
    </nav>
    <div class="gallery-preferences">
      <div class="preference-pair language-pair" role="group" aria-label={zh?'语言':'Language'}>
        {zh ? <span aria-current="true" lang="zh">中</span> : <a data-gallery-language href={switchUrl} lang="zh" aria-label="切换为中文">中</a>}
        <span class="preference-divider" aria-hidden="true">/</span>
        {zh ? <a data-gallery-language href={switchUrl} lang="en" aria-label="Switch to English">EN</a> : <span aria-current="true" lang="en">EN</span>}
      </div>
      <div class="preference-pair art-pair" id="gallery-theme" role="group" aria-label={zh?'画境':'Art theme'}>
        <button type="button" data-art-choice="landscape" aria-pressed="true" title={zh?'中国山水':'Chinese landscape'}>{zh?'山水':'Landscape'}</button>
        <span class="preference-divider" aria-hidden="true">/</span>
        <button type="button" data-art-choice="yokai" aria-pressed="false" title={zh?'日本 · 百鬼夜行':'Japanese yokai'}>{zh?'百鬼':'Yokai'}</button>
      </div>
    </div>
  </header>
<SiteBehavior/>
