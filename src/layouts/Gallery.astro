---
import BaseHead from '../components/BaseHead.astro';
import type { Lang } from '../i18n/ui';
import type { ImageMetadata } from 'astro';
import rich from '../assets/gallery/scroll-rich.png';
import { prefix } from '../lib/gallery';
import '../styles/gallery.css';
interface Props { lang:Lang; title:string; description:string; switchUrl:string; image?:ImageMetadata }
const {lang,title,description,switchUrl,image=rich}=Astro.props;
const base=prefix(lang), zh=lang==='zh';
---
<!doctype html>
<html lang={lang}>
<head>
  <BaseHead title={`${title} — ${zh?'沧浪':'Felix Han'}`} description={description} lang={lang} image={image}/>
  <link rel="alternate" hreflang={zh?'en':'zh'} href={new URL(switchUrl,Astro.site)}/>
  <link rel="icon" type="image/svg+xml" href="/cang-seal.svg"/>
</head>
<body class="gallery-site">
  <a class="gallery-skip" href="#main">{zh?'跳到正文':'Skip to content'}</a>
  <header class="gallery-header shell">
    <a class="gallery-brand" href={`${base}/`}><img src="/cang-seal.svg" alt="" width="40" height="42"/><span>{zh?'沧浪':'Felix Han'}</span></a>
    <nav aria-label={zh?'主导航':'Main navigation'}>
      {[[zh?'知':'Writing',`${base}/blog/`,zh?'知 · 博客文章':'Writing'],[zh?'行':'Atlas',`${base}/atlas/`,zh?'行 · 实践地图':'Atlas'],[zh?'工':'Works',`${base}/projects/`,zh?'工 · 项目作品':'Works'],[zh?'吾':'About',`${base}/about/`,zh?'吾 · 关于我':'About']].map(([label,href,meaning])=><a href={href} title={meaning} aria-label={meaning} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}
    </nav>
    <div class="gallery-preferences"><a data-gallery-language href={switchUrl} lang={zh?'en':'zh'}>{zh?'English':'中文'}</a><button id="gallery-theme" type="button" aria-label={zh?'切换明暗主题':'Toggle light and dark theme'} aria-pressed="false">{zh?'明暗':'Light / dark'}</button></div>
  </header>
  <main id="main" class="gallery-main" tabindex="-1"><slot/></main>
  <footer class="gallery-footer shell"><span>{zh?'沧浪 · 因好奇而构建，仍在慢慢展开。':'Felix Han · Built with curiosity. Still unfolding.'}</span><a href="#main">{zh?'回到开卷处':'Back to the beginning'}</a></footer>
  <script>
    const button=document.querySelector<HTMLButtonElement>('#gallery-theme');
    const sync=()=>button?.setAttribute('aria-pressed',String(document.documentElement.dataset.theme==='dark'));
    sync();button?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}sync()});
    document.querySelector<HTMLAnchorElement>('[data-gallery-language]')?.addEventListener('click',event=>{const a=event.currentTarget as HTMLAnchorElement;const url=new URL(a.href);url.search=location.search;url.hash=location.hash;a.href=url.href});
    for(const img of document.querySelectorAll<HTMLImageElement>('.exhibit-mount img,.detail-exhibit img')){
      const fallback=()=>{img.hidden=true;const mount=img.closest('.exhibit-mount')||img.parentElement;if(mount&&!mount.querySelector('.art-fallback')){const caption=document.createElement('span');caption.className='art-fallback';caption.textContent=(document.documentElement.lang==='zh'?'图片暂不可用：':'Image unavailable: ')+img.alt;mount.append(caption)}};
      img.addEventListener('error',fallback);if(img.complete&&!img.naturalWidth)fallback();
    }
  </script>
</body>
</html>
