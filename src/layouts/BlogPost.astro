---
import { Image } from 'astro:assets';
import { isRasterImage } from '../lib/social-card.mjs';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { defaultLang, localeUrl, useTranslations, type Lang } from '../i18n/ui';

// `featured` only drives the landing's Writing section; pages like About
// that hand-build these props shouldn't have to pass it.
type Props = Omit<CollectionEntry<'blog'>['data'], 'featured'> & {
  featured?: boolean;
  lang?: Lang;
  /** URL of this post in the other language, when a translation exists. */
  translationUrl?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  ogImage,
  tags,
  lang = defaultLang,
  translationUrl,
} = Astro.props;
const t = useTranslations(lang);
const isAbout=Astro.url.pathname.replace(/\/$/,'').endsWith('/about');
const slug=Astro.url.pathname.replace(/^\/(zh\/)?blog\//,'').replace(/\/$/,'');
const relatedWorks=isAbout?[]:(await getCollection('projects')).filter(p=>p.data.gallery?.relatedSlugs.includes(slug));
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={isRasterImage(ogImage) ? ogImage : heroImage}
      type="article"
      lang={lang}
      publishedTime={pubDate}
      updatedTime={updatedDate}
    />
    {
      translationUrl && (
        <>
          <link
            rel="alternate"
            hreflang={lang}
            href={new URL(Astro.url.pathname, Astro.site)}
          />
          <link
            rel="alternate"
            hreflang={lang === 'zh' ? 'en' : 'zh'}
            href={new URL(translationUrl, Astro.site)}
          />
        </>
      )
    }
    <style>
      .hero-image {
        margin-bottom: 2.5rem;
      }
      .hero-image img {
        display: block;
        width: 100%;
        border-radius: 2px;
        box-shadow: var(--shadow);
      }
      .title {
        margin-bottom: 2.5rem;
      }
      .title h1 {
        margin: 0.5rem 0 0;
        font-size: 2.4rem;
        line-height: 1.15;
      }
      .date {
        color: var(--muted);
        font-size: 0.9rem;
      }
      .last-updated-on {
        font-style: italic;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: var(--muted);
        font-size: 0.9rem;
        text-decoration: none;
      }
      .back-link:hover {
        color: var(--accent);
      }
      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .post-tag {
        font-size: 0.8rem;
        color: var(--muted);
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: 2px;
        padding: 0.2rem 0.7rem;
        text-decoration: none;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .post-tag:hover {
        color: var(--heading);
        border-color: var(--muted);
        text-decoration: none;
      }
    </style>
  </head>

  <body class="gallery-site reading-site">
    <Header lang={lang} switchUrl={translationUrl} />
    <main id="main" tabindex="-1">
      <article>
        {!isAbout&&<a class="back-link" href={localeUrl(lang, '/blog')}>{t('post.back')}</a>}
        {
          heroImage && (
            <div class="hero-image">
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
              />
            </div>
          )
        }
        <div class="title">
          {!isAbout&&<div class="date">
            <FormattedDate date={pubDate} lang={lang} />
            {
              updatedDate && (
                <span class="last-updated-on">
                  {' · '}{t('post.updated')} <FormattedDate date={updatedDate} lang={lang} />
                </span>
              )
            }
          </div>}
          <h1>{title}</h1>
          {
            tags && tags.length > 0 && (
              <div class="post-tags">
                {tags.map((tag) => (
                  <a class="post-tag" href={localeUrl(lang, `/blog/?tag=${tag}`)}>
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
        <div class="prose">
          <slot />
        </div>
        {relatedWorks.length>0&&<aside class="related-works"><h2>{lang==='zh'?'相关作品':'Related works'}</h2>{relatedWorks.map(p=><a href={localeUrl(lang,`/projects/${p.id}/`)}>{p.data.gallery!.name[lang]} <span aria-hidden="true">↗</span></a>)}</aside>}
      </article>
    </main>
    <Footer lang={lang} />
  </body>
</html>
